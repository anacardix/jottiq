<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 23-30. API 31+ uses data_extraction_rules.xml instead.
    See https://developer.android.com/guide/topics/data/autobackup

    Jottiq is local-only storage: back up the Room database (all note/folder data). Extend with
    the DataStore preferences file once settings land, excluding anything lock/credential-related.
-->
<full-backup-content>
    <include domain="database" path="." />
</full-backup-content>
