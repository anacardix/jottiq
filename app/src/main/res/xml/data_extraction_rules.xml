<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for API 31+ cloud backup and device-to-device transfer.
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes

    Jottiq is local-only storage: back up/transfer the Room database (all note/folder data).
    Extend with the DataStore preferences file once settings land, excluding anything
    lock/credential-related.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
